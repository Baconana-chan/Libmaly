# Discord Social SDK: keep only the runtime files actually used by LIBMALY.
third_party/discord_social_sdk/bin/debug/
third_party/discord_social_sdk/bin/release/arm64/
third_party/discord_social_sdk/lib/debug/
third_party/discord_social_sdk/lib/release/arm64/
third_party/discord_social_sdk/lib/release/*.aar
third_party/discord_social_sdk/lib/release/*.dbg
third_party/discord_social_sdk/lib/release/*.lib
third_party/discord_social_sdk/lib/release/*.xcframework/

# EOS SDK: keep only the runtime DLLs and C headers; exclude large/unneeded extras.
third_party/EOS-SDK/Samples/
third_party/EOS-SDK/ThirdPartyNotices/
third_party/EOS-SDK/SDK/Lib/
third_party/EOS-SDK/SDK/Tools/
